package aethel:core@0.1.0;

interface types {
  /// Closed set of failure reasons across all aethel:core operations.
  /// A flat variant — no operation's error nests another operation's error.
  variant identity-error {
    invalid-input-length,
    serialization-error,
    rejection-sampling-failed,
    norm-bound-violation,
    challenge-mismatch,
    invalid-attribute-commitment,
    threshold-not-met,
  }
}

interface identity {
  use types.{identity-error};

  /// A context-bound projection of a master identity at context τ.
  record ephemeral-projection {
    tau: list<u8>,
    matrix-a: list<u32>,
    public-b: list<u32>,
  }

  /// A zero-knowledge proof of ownership over an ephemeral-projection.
  record zk-identity-proof {
    commitment-w: list<u32>,
    challenge-c: list<u32>,
    response-z: list<u32>,
  }

  /// Project a master identity (from secret key material) at context τ.
  ///
  /// `randomness` MUST be at least 32 bytes of fresh, secret entropy, distinct
  /// per projection: it seeds the error term e_τ that makes b_τ an M-LWE sample
  /// rather than an exact linear image of the secret. τ MUST be single-use.
  plp-project-at-context: func(secret: list<u8>, tau: list<u8>, randomness: list<u8>) -> result<ephemeral-projection, identity-error>;

  /// Prove identity ownership at context τ.
  plp-prove-identity: func(secret: list<u8>, tau: list<u8>) -> result<zk-identity-proof, identity-error>;

  /// Verify a ZK identity proof against a projection.
  plp-verify: func(projection: ephemeral-projection, proof: zk-identity-proof) -> result<bool, identity-error>;

  /// An identity whose secret key material never leaves the component.
  ///
  /// The free functions above take `secret: list<u8>`, which means the caller
  /// holds the master secret and it crosses this boundary on every call. That
  /// contradicts the charter's "no private key material crosses out of L1", and
  /// there was no way to *create* an identity at all: `plp-project-at-context`
  /// can only project a secret someone else already generated.
  ///
  /// This resource is the answer to both. The secret is derived inside the
  /// component and stays here; only the public key, projections and proofs come
  /// out.
  resource master-identity {
    /// Derive an identity from caller-supplied entropy.
    ///
    /// Requires at least 32 bytes. The entropy is NOT the key: it is stretched
    /// through SHAKE-256 with domain separation, and the ML-DSA-65 signing key
    /// and the PLP master seed are derived from that stream. Deterministic, so
    /// the same entropy always yields the same identity.
    generate: static func(entropy: list<u8>) -> result<master-identity, identity-error>;

    /// The ML-DSA-65 public key. Safe to publish, and the only key material
    /// that crosses this boundary.
    public-key: func() -> list<u8>;

    /// Sign a message. FIPS 204 deterministic variant, so no randomness is
    /// needed at call time.
    sign: func(message: list<u8>) -> result<list<u8>, identity-error>;

    /// Project this identity at context tau. See `plp-project-at-context` for
    /// what `randomness` must be.
    project-at-context: func(tau: list<u8>, randomness: list<u8>) -> result<ephemeral-projection, identity-error>;

    /// Prove ownership of this identity at context tau.
    prove: func(tau: list<u8>) -> result<zk-identity-proof, identity-error>;
  }

  /// Verify an ML-DSA-65 signature.
  ///
  /// A free function, not a method: verification needs only public material, so
  /// requiring a `master-identity` would imply the verifier holds a secret it
  /// neither needs nor can have.
  ///
  /// Returns `ok(false)` for a well-formed signature that does not verify, and
  /// `err` only for input that cannot be parsed.
  verify-signature: func(public-key: list<u8>, message: list<u8>, signature: list<u8>) -> result<bool, identity-error>;
}

interface attestation {
  use types.{identity-error};

  /// Named disclosure slots — never a raw bitmask on the wire.
  flags disclosure-attributes {
    attribute0,
    attribute1,
    attribute2,
    attribute3,
    attribute4,
    attribute5,
    attribute6,
    attribute7,
  }

  /// A SAAP selective-disclosure proof.
  record saap-proof {
    context-tag: list<u8>,
    disclosed: disclosure-attributes,
    attributes: list<u64>,
    challenge: list<s32>,
    response-z: list<s32>,
    commitment-hash: list<u8>,
    commitment-w: list<s32>,
  }

  /// Prove selective attribute disclosure.
  ///
  /// `randomness` MUST be at least 32 bytes of fresh, secret entropy, distinct
  /// per proof: it seeds the sigma-protocol mask r that hides the secret key in
  /// the response z = r + c·sk.
  saap-prove: func(credential: list<u8>, disclosed: disclosure-attributes, tau: list<u8>, secret-key: list<u8>, randomness: list<u8>) -> result<saap-proof, identity-error>;

  /// Verify a SAAP selective disclosure proof.
  saap-verify: func(proof: saap-proof, tau: list<u8>) -> result<bool, identity-error>;
}

interface secret-sharing {
  use types.{identity-error};

  /// A single threshold share of split key material.
  record htss-share {
    index: u8,
    value: list<u8>,
  }

  /// Split key material into 5 Shamir shares (3-of-5 threshold).
  htss-split: func(secret: list<u8>) -> result<list<htss-share>, identity-error>;

  /// Reconstruct key material from threshold shares.
  htss-reconstruct: func(shares: list<htss-share>) -> result<list<u8>, identity-error>;
}

world aethel-core {
  import types;

  export identity;
  export attestation;
  export secret-sharing;
}
